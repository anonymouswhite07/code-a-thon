# ==============================================================================
# GCT CODE-A-THON 2026 - MAIL BOT CONFIGURATION
# Organised by: Department of Information Technology (IT) in Coding Club
# Venue: D Block IT Lab - 2 | Date: 14.10.2026 @ 10:00 AM
# ==============================================================================

# --- SMTP SERVER SETTINGS ---
# Option 1: Gmail (Recommended for quick college blasts)
# Note: Generate an "App Password" at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=codingclub.gct@gmail.com
SMTP_PASS=your_16_character_google_app_password

# Option 2: Brevo / SendGrid / Custom College Mail Server
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_brevo_login
# SMTP_PASS=your_brevo_smtp_key

# --- SENDER DISPLAY ---
MAIL_FROM="Coding Club - Dept of IT <codingclub.gct@gmail.com>"
MAIL_REPLY_TO="codingclub.gct@gmail.com"

# --- RATE LIMITING ---
# Delay in milliseconds between each email to prevent SMTP rate limits/flagging
SEND_DELAY_MS=600

# --- DATABASE (OPTIONAL - Defaults to root .env if omitted) ---
# DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
